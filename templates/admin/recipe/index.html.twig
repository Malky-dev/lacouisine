{% extends 'admin/admin.html.twig' %}

{% block title %}Toutes les recettes{% endblock %}

{% block body %}

<div class="d-grid gap-2 col-4 mx-auto mb-5">
    <a class="btn btn-primary text-center" href="{{ url('admin.recipe.create') }}">Ajouter une recette</a>
</div>

<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th class="w-50"> {{knp_pagination_sortable(recipes, 'Nom de la recette', 'r.title')}} </th>
                <th class="w-25"> {{knp_pagination_sortable(recipes, 'Catégorie', 'c.name')}} </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {%  for recipe in recipes %}
                <tr>
                    <td>
                        <a href="{{ url('admin.recipe.edit' , {id: recipe.id}) }}"> {{ recipe.title }} </a>
                    </td>
                    <td>
                        <p>{{ recipe.category.name | default('') }}</p>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-info btn-sm" href="{{ url('admin.recipe.edit' , {id: recipe.id}) }}"> Modifier </a>
                            <form action="{{ path('admin.recipe.delete', {id: recipe.id}) }}" method="post">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-danger btn-sm"> Supprimer </a>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-5">
        {{ knp_pagination_render(recipes)}}
    </div>

</div>

{% endblock %}
