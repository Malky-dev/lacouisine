{% extends 'admin/admin.html.twig' %}

{% block title %}Toutes les catégories{% endblock %}

{% block body %}

<div class="d-grid gap-2 col-4 mx-auto mb-5">
    <a class="btn btn-primary text-center" href="{{ url('admin.category.create') }}">Ajouter une catégorie</a>
</div>

<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th class="w-75"> {{knp_pagination_sortable(categories, 'Liste des Catégories', 'c.name')}} </th>
                <th class="w-75"> {{knp_pagination_sortable(categories, 'Nombre de Recettes', 'recipeCount')}} </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {%  for category in categories %}
                <tr>
                    <td>
                        <a href="{{ url('admin.category.edit' , {id: category.id}) }}"> {{ category.name }} </a>
                    </td>
                    <td>
                        {{ category.recipeCount }}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-info btn-sm" href="{{ url('admin.category.edit' , {id: category.id}) }}"> Modifier </a>
                            <form action="{{ path('admin.category.delete', {id: category.id}) }}" method="post">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-danger btn-sm"> Supprimer </a>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-5">
        {{ knp_pagination_render(categories)}}
    </div>

</div>

{% endblock %}
